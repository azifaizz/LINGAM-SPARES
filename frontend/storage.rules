rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Attendance App releases: authenticated users (Admin / Cashier) can read/download
    match /app-releases/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Default storage rules
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
